---
import { Image } from "astro:assets"
import { emails } from "@/configs/contact"
import dsbLogo from "@/images/mcm-dsb-crce.png"
import dsbFloorMap from "@/images/dsb-floor-map.jpg"
---

<footer
  class="relative bg-gray-600 p-4 text-white sm:p-6 lg:p-8"
  aria-label="DeGroote School of Business Footer"
>
  <div
    class="absolute -top-0.5 left-0 z-10 h-0.5 w-full bg-gray-600"
    aria-hidden="true"
  >
  </div>
  <div
    class="mx-auto flex max-w-7xl flex-wrap justify-center gap-8 sm:gap-10 lg:gap-x-20"
  >
    <div class="flex flex-col items-center">
      <Image
        src={dsbLogo}
        alt="McMaster DeGroote School of Business CRCE logo"
        class="w-72 brightness-200"
      />
    </div>
    <div class="flex flex-wrap justify-center gap-4 text-sm max-lg:text-center">
      <div>
        <h2 class="font-sans-condensed mb-1.5 text-xl font-semibold">
          Address Information
        </h2>
        <a
          href="https://www.google.com/maps/place/?q=place_id:ChIJobcBgFObLIgRjAnSOJ7TJEM"
          target="_blank"
          rel="noopener noreferrer"
          class="underline hover:no-underline"
        >
          CRCE DeGroote School of Business (DSB)<br />
          Room A113<br />
          McMaster University<br />
          1280 Main Street West<br />
          Hamilton, ON L8S 4M4, Canada<br />
        </a>
      </div>
      <Image
        src={dsbFloorMap}
        alt="Floor map showing Room A113 location"
        class="max-w-50 rounded-md object-contain"
      />
    </div>
    <div class="text-sm max-lg:text-center">
      <h2 class="font-sans-condensed mb-1.5 text-xl font-semibold">
        Contact Information
      </h2>
      <div class="space-y-1">
        {
          emails.map((email) => (
            <a
              href={`mailto:${email}`}
              class="block underline hover:no-underline"
            >
              {email}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
