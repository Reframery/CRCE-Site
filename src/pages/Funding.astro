---
// src/pages/Funding.astro — an Astro PAGE.
// IMPORTANT: only frontmatter (this block) + markup below. No component definitions here.
// An .astro file is HTML/Astro markup, not JSX — pasting the TSX component into it is what
// produced hundreds of errors. The React UI lives in:
//     src/components/funding/FundingPage.tsx   (copy of src/exports/FundingPage.tsx)
// Adjust the import path below if you put the component somewhere else.
import Layout from "@/layouts/Layout.astro";
import { SITE_DESCRIPTION } from "@/configs/site.ts";
import FundingPage from "@/components/Funding/Funding";
---

<Layout title="Funding" description={SITE_DESCRIPTION}>
  <main class="funding-page">
    <FundingPage client:load />
  </main>
</Layout>

<!-- Same fonts as crce.info: Roboto (body) + Roboto Condensed (headings) -->
<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&family=Roboto+Condensed:wght@400;500;600;700;900&display=swap");

  .funding-page {
    font-family: "Roboto", ui-sans-serif, system-ui, sans-serif;
  }

  .funding-page h1,
  .funding-page h2,
  .funding-page h3 {
    font-family: "Roboto Condensed", "Roboto", ui-sans-serif, system-ui, sans-serif;
  }
</style>