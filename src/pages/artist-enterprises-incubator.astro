---
import { Font } from "astro:assets"
import { SITE_TITLE } from "@/configs/site"
import DSBFooter from "@/components/DSBFooter.astro"
import McMasterFooter from "@/components/McMasterFooter.astro"
import IncubatorPage from "@/components/artist-enterprises-incubator/Page"
import "@/styles/global.css"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#7a003c" />
    <meta name="robots" content="noindex, nofollow" />
    <Font cssVariable="--font-roboto" preload />
    <Font cssVariable="--font-roboto-condensed" preload />
    <title>Artist Enterprises Incubator - {SITE_TITLE}</title>
  </head>
  <body>
    <div class="flex min-h-screen flex-col">
      <main class="flex-1">
        <IncubatorPage client:load data-pagefind-ignore />
      </main>
      <DSBFooter />
      <McMasterFooter />
    </div>
  </body>
</html>
